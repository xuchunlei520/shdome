{
  "schema": 2,
  "id": "zentao",
  "name": "禅道",
  "version": "21.7",
  "description": "项目管理与研发协作平台",
  "category": "项目管理",
  "architectures": ["amd64", "arm64"],
  "services": {
    "app": {
      "image": "easysoft/zentao:21.7",
      "containerName": "shdome-zentao",
      "environment": {"MYSQL_INTERNAL": "true"},
      "secretEnvironment": {"ZT_MYSQL_PASSWORD": "ZT_MYSQL_PASSWORD"},
      "volumes": [
        {"source": "zentao-data", "target": "/data"}
      ]
    }
  },
  "resources": {"diskGB": 5, "memoryMB": 2048},
  "secrets": [
    {"name": "ZT_MYSQL_PASSWORD", "bytes": 24}
  ],
  "ports": [
    {"name": "http", "service": "app", "containerPort": 80, "defaultHostPort": 8082, "protocol": "tcp", "primary": true}
  ],
  "healthcheck": {
    "type": "http",
    "service": "app",
    "port": "http",
    "path": "/",
    "timeoutSeconds": 300
  },
  "routing": {
    "enabled": true,
    "service": "app",
    "port": "http",
    "scheme": "http",
    "defaultAccessMode": "direct"
  }
}
