{
  "schema": 1,
  "id": "vaultwarden",
  "name": "Vaultwarden",
  "version": "1.37.2",
  "description": "兼容 Bitwarden 客户端的轻量级密码管理服务",
  "category": "安全与密码",
  "architectures": ["amd64", "arm64"],
  "services": {
    "app": {
      "image": "vaultwarden/server:1.37.2-alpine",
      "containerName": "shdome-vaultwarden",
      "containerPort": 80
    }
  },
  "resources": {"diskGB": 1, "memoryMB": 256},
  "environment": {"SIGNUPS_ALLOWED": true},
  "volumes": [
    {"source": "data", "target": "/data", "type": "directory"}
  ],
  "backup": {"strategy": "cold-filesystem"},
  "healthcheck": {"type": "http", "path": "/alive", "timeoutSeconds": 120},
  "routing": {"enabled": true, "defaultAccessMode": "direct", "defaultHostPort": 8085}
}
