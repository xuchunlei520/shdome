{
  "schema": 2,
  "id": "vaultwarden",
  "name": "Vaultwarden",
  "version": "1.37.2",
  "description": "兼容 Bitwarden 客户端的轻量级密码管理服务",
  "category": "安全与密码",
  "architectures": ["amd64", "arm64"],
  "services": {
    "app": {
      "image": "vaultwarden/server:1.37.2-alpine",
      "containerName": "shdome-vaultwarden",
      "environment": {"SIGNUPS_ALLOWED": true},
      "volumes": [
        {"source": "data", "target": "/data", "type": "directory"}
      ]
    }
  },
  "resources": {"diskGB": 1, "memoryMB": 256},
  "ports": [
    {"name": "http", "service": "app", "containerPort": 80, "defaultHostPort": 8085, "protocol": "tcp", "primary": true}
  ],
  "backup": {"strategy": "cold-filesystem"},
  "healthcheck": {"type": "http", "service": "app", "port": "http", "path": "/alive", "timeoutSeconds": 120},
  "routing": {"enabled": true, "service": "app", "port": "http", "scheme": "http", "defaultAccessMode": "direct"}
}
