{
  "schema": 1,
  "id": "cloudreve",
  "name": "Cloudreve",
  "version": "3.8.3",
  "description": "支持多种存储策略的自托管网盘系统",
  "category": "存储",
  "architectures": ["amd64", "arm64"],
  "services": {
    "app": {
      "image": "cloudreve/cloudreve:3.8.3",
      "containerName": "shdome-cloudreve",
      "containerPort": 5212
    }
  },
  "resources": {"diskGB": 2, "memoryMB": 512},
  "environment": {},
  "volumes": [
    {"source": "uploads", "target": "/cloudreve/uploads"},
    {"source": "avatar", "target": "/cloudreve/avatar"},
    {"source": "config", "target": "/cloudreve/config"},
    {"source": "cloudreve.db", "target": "/cloudreve/cloudreve.db", "type": "file"}
  ],
  "backup": {
    "strategy": "cold-filesystem",
    "logical": {"type": "sqlite", "source": "cloudreve.db", "output": "cloudreve.sql"}
  },
  "healthcheck": {
    "type": "http",
    "path": "/",
    "timeoutSeconds": 120
  },
  "routing": {
    "enabled": true,
    "defaultAccessMode": "direct",
    "defaultHostPort": 5212
  }
}
