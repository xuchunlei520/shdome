{
  "schema": 2,
  "id": "cloudreve",
  "name": "Cloudreve",
  "version": "3.8.3",
  "description": "支持多种存储策略的自托管网盘系统",
  "category": "存储",
  "architectures": ["amd64", "arm64"],
  "services": {
    "app": {
      "image": "cloudreve/cloudreve:3.8.3",
      "containerName": "shdome-cloudreve",
      "volumes": [
        {"source": "uploads", "target": "/cloudreve/uploads"},
        {"source": "avatar", "target": "/cloudreve/avatar"},
        {"source": "config", "target": "/cloudreve/config"},
        {"source": "cloudreve.db", "target": "/cloudreve/cloudreve.db", "type": "file"}
      ]
    }
  },
  "resources": {"diskGB": 2, "memoryMB": 512},
  "ports": [
    {"name": "http", "service": "app", "containerPort": 5212, "defaultHostPort": 5212, "protocol": "tcp", "primary": true}
  ],
  "backup": {
    "strategy": "cold-filesystem",
    "logical": {"type": "sqlite", "service": "app", "source": "cloudreve.db", "output": "cloudreve.sql"}
  },
  "healthcheck": {
    "type": "http",
    "service": "app",
    "port": "http",
    "path": "/",
    "timeoutSeconds": 120
  },
  "routing": {
    "enabled": true,
    "service": "app",
    "port": "http",
    "scheme": "http",
    "defaultAccessMode": "direct"
  }
}
