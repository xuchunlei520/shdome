{
  "schema": 2,
  "id": "qinglong",
  "name": "青龙面板",
  "version": "2.17.12",
  "description": "支持定时任务管理的自动化面板",
  "category": "自动化",
  "architectures": ["amd64", "arm64"],
  "services": {
    "app": {
      "image": "whyour/qinglong:2.17.12",
      "containerName": "shdome-qinglong",
      "environment": {"QL_BRANCH": "master"},
      "volumes": [
        {"source": "ql-data", "target": "/ql/data"}
      ]
    }
  },
  "resources": {"diskGB": 2, "memoryMB": 512},
  "ports": [
    {"name": "http", "service": "app", "containerPort": 5700, "defaultHostPort": 5700, "protocol": "tcp", "primary": true}
  ],
  "healthcheck": {
    "type": "http",
    "service": "app",
    "port": "http",
    "path": "/",
    "timeoutSeconds": 180
  },
  "routing": {
    "enabled": true,
    "service": "app",
    "port": "http",
    "scheme": "http",
    "defaultAccessMode": "direct"
  }
}
