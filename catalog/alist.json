{
  "schema": 2,
  "id": "alist",
  "name": "AList",
  "version": "3.63.0",
  "description": "支持多种存储提供商的文件列表与 WebDAV 服务",
  "category": "文件与存储",
  "architectures": ["amd64", "arm64"],
  "services": {
    "app": {
      "image": "xhofe/alist:v3.63.0",
      "containerName": "shdome-alist",
      "environment": {"PUID": 0, "PGID": 0, "UMASK": "022"},
      "volumes": [
        {"source": "data", "target": "/opt/alist/data", "type": "directory"}
      ]
    }
  },
  "resources": {"diskGB": 1, "memoryMB": 256},
  "ports": [
    {"name": "http", "service": "app", "containerPort": 5244, "defaultHostPort": 5244, "protocol": "tcp", "primary": true}
  ],
  "backup": {"strategy": "cold-filesystem"},
  "healthcheck": {"type": "http", "service": "app", "port": "http", "path": "/", "timeoutSeconds": 120},
  "routing": {"enabled": true, "service": "app", "port": "http", "scheme": "http", "defaultAccessMode": "direct"}
}
