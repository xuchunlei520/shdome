{
  "schema": 2,
  "id": "uptime-kuma",
  "name": "Uptime Kuma",
  "version": "1.23.16",
  "description": "轻量易用的服务可用性监控面板",
  "category": "监控",
  "architectures": ["amd64", "arm64"],
  "services": {
    "app": {
      "image": "louislam/uptime-kuma:1.23.16",
      "containerName": "shdome-uptime-kuma",
      "volumes": [
        {"source": "app-data", "target": "/app/data"}
      ]
    }
  },
  "resources": {"diskGB": 1, "memoryMB": 256},
  "ports": [
    {"name": "http", "service": "app", "containerPort": 3001, "defaultHostPort": 3001, "protocol": "tcp", "primary": true}
  ],
  "healthcheck": {
    "type": "http",
    "service": "app",
    "port": "http",
    "path": "/",
    "timeoutSeconds": 120
  },
  "routing": {
    "enabled": true,
    "service": "app",
    "port": "http",
    "scheme": "http",
    "defaultAccessMode": "direct"
  }
}
