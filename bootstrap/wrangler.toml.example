name = "shdome-bootstrap"
main = "worker.js"
compatibility_date = "2026-08-01"

[vars]
SHDOME_RELEASE_VERSION = "v0.1.7"
SHDOME_RELEASE_URL = "https://github.com/OWNER/shdome/releases/download/v0.1.7/shdome-v0.1.7.tar.gz"
SHDOME_RELEASE_SHA256 = "替换为64位SHA256"
SHDOME_INSTALLER_URL = "https://raw.githubusercontent.com/OWNER/shdome/固定40位commit/bootstrap/install.sh"
