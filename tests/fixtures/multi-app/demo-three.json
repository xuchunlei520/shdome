{
  "schema": 2,
  "id": "demo-three",
  "name": "Demo Three",
  "version": "1.28.0",
  "description": "多应用同容器端口验收应用三",
  "category": "测试",
  "architectures": ["amd64", "arm64"],
  "services": {"app": {"image": "nginx:1.28.0-alpine", "containerName": "shdome-demo-three"}},
  "resources": {"diskGB": 1, "memoryMB": 64},
  "ports": [{"name": "http", "service": "app", "containerPort": 80, "defaultHostPort": 18084, "protocol": "tcp", "primary": true}],
  "healthcheck": {"type": "http", "service": "app", "port": "http", "path": "/", "timeoutSeconds": 60},
  "routing": {"enabled": true, "service": "app", "port": "http", "scheme": "http", "defaultAccessMode": "direct"}
}
