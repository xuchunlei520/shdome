{
  "schema": 2,
  "id": "demo-bad-health",
  "name": "Demo Bad Health",
  "version": "1.28.0",
  "description": "健康检查失败回滚验收应用",
  "category": "测试",
  "architectures": ["amd64", "arm64"],
  "services": {"app": {"image": "nginx:1.28.0-alpine", "containerName": "shdome-demo-bad-health"}},
  "resources": {"diskGB": 1, "memoryMB": 64},
  "ports": [{"name": "http", "service": "app", "containerPort": 80, "defaultHostPort": 18085, "protocol": "tcp", "primary": true}],
  "healthcheck": {"type": "http", "service": "app", "port": "http", "path": "/must-return-404", "timeoutSeconds": 5},
  "routing": {"enabled": true, "service": "app", "port": "http", "scheme": "http", "defaultAccessMode": "direct"}
}
